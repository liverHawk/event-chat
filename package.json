{
  "name": "event-chat",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "wrangler deploy --dry-run --outdir=.wrangler/test-build >/dev/null && node --test test/*.test.ts",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "room:add": "node scripts/room-cli.ts add",
    "room:list": "node scripts/room-cli.ts list",
    "room:delete": "node scripts/room-cli.ts delete"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "wrangler": "^4.110.0"
  }
}
